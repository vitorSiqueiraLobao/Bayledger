# Local development settings. Copy to .env (git-ignored) and edit.
# Every variable is optional: without a .env the app runs with the defaults shown here.
# Put comments on their own line, and quotes around values with spaces.
# For production use deploy/oficina.env.example instead.

# ---- Django ----
# 1 = development (runserver, dev secret key). Production must set 0 and a real DJANGO_SECRET_KEY.
DJANGO_DEBUG=1
#DJANGO_SECRET_KEY=
#DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
#DJANGO_TIME_ZONE=America/Sao_Paulo
# Folder for db.sqlite3, media/ (note photos) and cache/. Default: the project folder.
#OFICINA_DATA_DIR=

# ---- Your shop ----
# Name printed on the OS and in the WhatsApp message
OFICINA_NOME="Minha Oficina"
# Labor is split between the owner and one mechanic; these are the names shown on screen
OFICINA_NOME_DONO="Dono"
OFICINA_NOME_MECANICO="Mecânico"
# Owner's share of the labor when the mechanic works alone / when both work on it (fractions, 0 to 1)
OFICINA_PARTE_DONO_MECANICO=0.30
OFICINA_PARTE_DONO_AMBOS=0.50
# Card surcharge: 1.10 = 10% on top of the cash price
OFICINA_ACRESCIMO_CARTAO=1.10
# Country code added to customers' phone numbers for the WhatsApp link (55 = Brazil)
OFICINA_DDI=55
# Set to 1 ONLY behind Cloudflare (see deploy/oficina.env.example)
OFICINA_CLOUDFLARE=0
