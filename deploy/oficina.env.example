# PRODUCTION settings. Copy to ~/oficina-dados/oficina.env on the server and fill in.
# This file is read by deploy/rodar.sh (so it must be valid shell) and must NEVER go to git.
# Put comments on their own line, and quotes around values with spaces.

DJANGO_DEBUG=0
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Domain(s) the app answers to, comma-separated (the one configured in your tunnel/proxy)
DJANGO_ALLOWED_HOSTS=oficina.example.com,localhost
# Folder with the database, photos and local backups (this is what you back up)
OFICINA_DATA_DIR=/Users/YOUR_USER/oficina-dados
# rclone destination for the off-site backup (e.g. a Cloudflare R2 bucket). Empty = local backup only.
OFICINA_BACKUP_REMOTO=

# ---- Your shop (same keys as the root .env.example) ----
OFICINA_NOME="Minha Oficina"
# Owner's name as shown on screen. Mechanics and their sharing rule are added in the admin panel
# (/painel/ -> Mecânicos), not here.
OFICINA_NOME_DONO="Dono"
# Card surcharge: 1.10 = 10% on top of the cash price
OFICINA_ACRESCIMO_CARTAO=1.10
# Country code added to customers' phone numbers for the WhatsApp link (55 = Brazil)
OFICINA_DDI=55
# Set to 1 ONLY if the app is behind Cloudflare (tunnel or proxy). It makes the login lockout use the
# real client IP from the CF-Connecting-IP header; anywhere else that header can be forged.
OFICINA_CLOUDFLARE=0
