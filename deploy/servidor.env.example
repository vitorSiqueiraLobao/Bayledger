# Your shop's settings, pushed to the SERVER's oficina.env by deploy.sh on every deploy
# (or alone, with `deploy/deploy.sh --env`). Copy to deploy/servidor.env (git-ignored) and edit.
#
# Only OFICINA_* keys (except OFICINA_DATA_DIR) and DJANGO_TIME_ZONE are applied. Secrets, domain and data
# folder are never touched: they live only in the server's own oficina.env. An empty value never erases anything.
# The previous server file is kept as oficina.env.anterior.
# Meaning of each key: see the table in the root README.

OFICINA_NOME="Minha Oficina"
OFICINA_NOME_DONO="Dono"
OFICINA_ACRESCIMO_CARTAO=1.10
OFICINA_DDI=55
# Behind a Cloudflare Tunnel: 1
OFICINA_CLOUDFLARE=1
#DJANGO_TIME_ZONE=America/Sao_Paulo
