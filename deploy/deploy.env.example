# Settings for the scripts that run on YOUR computer (deploy.sh, puxar-backup.sh).
# Copy to deploy/deploy.env (git-ignored) and edit. Not shipped to the server.

# SSH target of the server that runs the app (key-based login, no password prompt).
OFICINA_HOST=youruser@your-server.local

# Public address of the app. Only used by deploy.sh for a final health check;
# leave empty to skip it.
OFICINA_URL=https://oficina.example.com

# Where puxar-backup.sh saves the backups on your computer (optional).
#OFICINA_BACKUP_LOCAL=$HOME/backups/oficina
